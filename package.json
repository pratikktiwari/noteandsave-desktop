{
  "name": "noteandsave-desktop",
  "productName": "Note & Save",
  "version": "1.0.4",
  "description": "A local-first desktop note-taking app with rich editor and whiteboards",
  "main": ".vite/build/main.js",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "test": "tsx --test src/main/*.test.ts",
    "test:mobile": "npm test --workspace @noteandsave/mobile",
    "typecheck:mobile": "npm run typecheck --workspace @noteandsave/mobile",
    "mobile:start": "npm start --workspace @noteandsave/mobile",
    "mobile:android": "npm run android --workspace @noteandsave/mobile",
    "postinstall": "patch-package"
  },
  "keywords": [],
  "author": {
    "name": "Pratik Tiwari",
    "email": "ipratiktiwari@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^41.10.6",
    "electron-rebuild": "^3.2.9",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "patch-package": "^8.0.1",
    "tsx": "^4.20.6",
    "typescript": "~4.5.4",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@noteandsave/workspace": "1.0.0",
    "@noteandsave/workspace-codec": "1.0.0",
    "@tiptap/extension-code-block-lowlight": "^3.27.1",
    "@tiptap/extension-color": "^3.28.0",
    "@tiptap/extension-highlight": "^3.27.1",
    "@tiptap/extension-image": "^3.27.1",
    "@tiptap/extension-link": "^3.27.1",
    "@tiptap/extension-placeholder": "^3.27.1",
    "@tiptap/extension-table": "^3.27.1",
    "@tiptap/extension-table-cell": "^3.27.1",
    "@tiptap/extension-table-header": "^3.27.1",
    "@tiptap/extension-table-row": "^3.27.1",
    "@tiptap/extension-task-item": "^3.27.1",
    "@tiptap/extension-task-list": "^3.27.1",
    "@tiptap/extension-text-style": "^3.28.0",
    "@tiptap/extension-underline": "^3.27.1",
    "@tiptap/markdown": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "@tiptap/suggestion": "^3.27.1",
    "electron-squirrel-startup": "^1.0.1",
    "isomorphic-git": "^1.41.7",
    "katex": "^0.17.0",
    "lowlight": "^3.3.0",
    "nanoid": "^5.1.16",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "sql.js": "^1.14.1",
    "tippy.js": "^6.3.7",
    "yaml": "^2.8.1"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "electron-winstaller@5.4.4": true,
    "esbuild@0.21.5": true,
    "lzma-native@8.0.6": true
  }
}
